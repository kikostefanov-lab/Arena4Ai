# ─── Database ────────────────────────────────────────────────────────────────
# Required for PostgreSQL persistence
DATABASE_URL=postgresql://postgres:arena@localhost:5432/arena

# ─── API auth ────────────────────────────────────────────────────────────────
# Optional shared secret for the orchestrator's HTTP API.
#
# When set, every request using a mutating verb (POST, PUT, PATCH, DELETE)
# requires:
#     Authorization: Bearer <ARENA_API_KEY>
# That is enforced once, app-wide, in server/app.ts — so it covers starting a
# competition, forge, synthesis, re-judge, cancel/pause/resume, delete, creating
# a tournament, writing briefs/personas/agents, and the AI generation routes
# (which spawn the `claude` CLI on this machine under your own login).
#
# GET requests stay open — the dashboard, event log and leaderboard are readable
# without a key by design. Leave this empty to disable auth entirely (dev mode);
# that is fine on a laptop and not fine on a reachable port.
#
# Set the SAME value in the web package's environment: the Next.js proxy routes
# read ARENA_API_KEY and attach the header for you, so the browser never sees it.
#
# Set this whenever the orchestrator port is reachable by anything other than
# your own machine. It is a single shared secret, not a user system.
ARENA_API_KEY=

# ─── Agent isolation ─────────────────────────────────────────────────────────
# Competitions run each agent CLI inside the `arena-agent:latest` Docker
# container by default. Build it once with:
#     docker build -f Dockerfile.agent -t arena-agent:latest .
#
# Set to true to run the agent CLIs directly on this machine instead. They then
# have your filesystem, your network and your credentials — only do this on a
# machine you own, for a port nobody else can reach.
ARENA_SKIP_SANDBOX=

# ─── Agent binaries ──────────────────────────────────────────────────────────
# Paths to the agent CLIs. Resolved from PATH when unset. These are read from
# the environment ONLY — an HTTP request can never choose which binary runs.
CLAUDE_BIN=claude
CODEX_BIN=codex
GEMINI_BIN=gemini

# Where competition event logs are written (defaults to the package default).
ARENA_LOG_DIR=

# ─── Provider API keys: none needed ──────────────────────────────────────────
# Arena4Ai drives the agent CLIs you already have installed and signed in, and
# it never reads ANTHROPIC_API_KEY, OPENAI_API_KEY or any other provider key.
# The Forge, judging, synthesis and brief generation all shell out to `claude`.
# (`@anthropic-ai/sdk` is a declared but unused dependency of the orchestrator.)
# The one place the name appears is a hint in the "claude is installed but not
# authenticated" error, suggesting you sign the CLI in.

# ─── Executing model-written deliverables ────────────────────────────────────
# To score a `correctness` criterion against a brief's expectedOutput, the
# fallback automated scorer must RUN the competitor's deliverable and diff its
# stdout. That happens in the orchestrator process — on the HOST, as your user,
# EVEN WHEN the Docker sandbox is enabled for the agents. The sandbox covers the
# agents; it has never covered this.
#
# So it is off by default. Set to exactly `true` to opt in. Read from the
# environment only — an HTTP request can never turn it on.
#
# With it unset, the affected criterion is reported as SKIPPED and excluded from
# the weighted score (not scored zero — a check that never ran and a check that
# failed are different facts). See judging/rubric-scorer.ts.
ARENA_ALLOW_HOST_CODE_EXECUTION=

# ─── Web ─────────────────────────────────────────────────────────────────────
# WebSocket URL for the web UI (must be reachable from the browser, not proxied)
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Orchestrator base URL for Next.js proxy routes
ORCHESTRATOR_URL=http://localhost:3000
