    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.9",
